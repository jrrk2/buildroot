# Target options
BR2_riscv=y
BR2_RISCV_32=y

# Instruction Set Extensions - rv32imafdc (compressed + hard-float)
BR2_riscv_custom=y
BR2_RISCV_ISA_CUSTOM_RVM=y
BR2_RISCV_ISA_CUSTOM_RVA=y
BR2_RISCV_ISA_CUSTOM_RVF=y
BR2_RISCV_ISA_CUSTOM_RVD=y
BR2_RISCV_ISA_CUSTOM_RVC=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ABI_ILP32D=y

# Use musl instead of glibc (saves ~2MB in rootfs, critical for 8MB RAM)
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# GCC
BR2_GCC_VERSION_13_X=y
BR2_OPTIMIZE_S=y

# System - minimal
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y

# BusyBox - minimal
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Filesystem — disable all rootfs image formats.
# We only need the target/ directory for genromfs.
# Any rootfs format pulls in host-fakeroot → host-acl → host-attr,
# which fails on macOS (missing l*xattr functions).
# BR2_TARGET_ROOTFS_CPIO is not set
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

# Kernel header version
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_9=y

# Kernel and OpenSBI are managed as git submodules (linux-xip/, opensbi-xip/),
# not built by buildroot.  Buildroot only provides the toolchain and rootfs.
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_OPENSBI is not set

# Rootfs customisation
BR2_ROOTFS_OVERLAY="$(TOPDIR)/board/litex_vexriscv/rootfs_overlay"
# Post-build script reinstalls dev headers stripped by target-finalize
BR2_ROOTFS_POST_BUILD_SCRIPT="$(TOPDIR)/board/litex_vexriscv/post-build.sh"

# NFS mount support (busybox mount -t nfs needs libtirpc for RPC headers)
BR2_PACKAGE_LIBTIRPC=y

# Disable extra packages
# BR2_PACKAGE_PPP is not set

# C++ toolchain support (required by gcc8-native: GCC 8 source is C++)
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Sonata additions
# BR2_PACKAGE_NCURSES is not set
# BR2_PACKAGE_COREUTILS is not set
# BR2_PACKAGE_PROCPS_NG is not set
# BR2_PACKAGE_TCC is not set
# BR2_PACKAGE_GCC142 is not set
BR2_PACKAGE_GMP=y
BR2_PACKAGE_MPFR=y
BR2_PACKAGE_MPC=y
BR2_PACKAGE_GCC8_NATIVE=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_FLEX=y
BR2_PACKAGE_BISON=y

# Benchmarks
BR2_PACKAGE_DHRYSTONE=y
BR2_PACKAGE_WHETSTONE=y
BR2_PACKAGE_COREMARK=y
# BR2_PACKAGE_STRESS is not set
# BR2_PACKAGE_IPERF3 is not set

# SSH (dropbear — tiny SSH server/client with SCP)
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_SMALL=y

# Utilities
BR2_PACKAGE_LUA=y
